# BasicSchemaFlow

main: kit: flow: BasicSchemaFlow:
{
  entity: "schema",
  kind: "basic",
  name: "BasicSchemaFlow",
  step: [
    {
      i: {
        ref: "schema_ref01",
        srcdatavar: "schema_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-schema_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSchemaFlow"
}