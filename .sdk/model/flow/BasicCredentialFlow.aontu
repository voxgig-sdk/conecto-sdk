# BasicCredentialFlow

main: kit: flow: BasicCredentialFlow:
{
  entity: "credential",
  kind: "basic",
  name: "BasicCredentialFlow",
  step: [
    {
      input: {
        ref: "credential_ref01",
        srcdatavar: "credential_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-credential_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCredentialFlow"
}