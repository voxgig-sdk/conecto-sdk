# Entity: credential

main: kit: entity: credential: {

  alias: field: {}

  fields: [
    {
      name: "widget_id"
      req: false
      short: "Set when the credential is widget-scoped rather than workspace-wide."
      type: "`$INTEGER`"
    }
    {
      name: "workspace_id"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "credential"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/me/"
          parts: [
            "me"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
