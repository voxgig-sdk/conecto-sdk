# Entity: credential

main: kit: entity: credential: {

  alias: field: {}

  fields: {
    widget_id: {
      h: "Widget Id"
      n: "widget_id"
      r: false
      sh: "Set when the credential is widget-scoped rather than workspace-wide."
      t: "`$INTEGER`"
    }
    workspace_id: {
      h: "Workspace Id"
      n: "workspace_id"
      r: false
      t: "`$INTEGER`"
    }
  }

  name: "credential"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /me/"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/me/"
          s: [
            {
              lit: "me"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
