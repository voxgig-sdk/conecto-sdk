  name: "message"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /widgets/{id}/visitors/{session}/message/"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "idempotency_key"
