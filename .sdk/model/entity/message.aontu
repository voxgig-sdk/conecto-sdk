                r: false
                t: "`$STRING`"
              }
            ]
            params: [
              {
                k: "param"
                n: "session"
                or: "session"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "widget_id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "POST"
          o: "/widgets/{id}/visitors/{session}/message/"
          q: {
            exist: [
              "idempotency_key"
              "session"
              "widget_id"
            ]
          }
          r: {
            param: {
              id: "widget_id"
            }
          }
          s: [
            {
              lit: "widgets"
            }
            {
              var: "widget_id"
            }
            {
              lit: "visitors"
            }
            {
              var: "session"
            }
            {
              lit: "message"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "POST /conversations/{id}/messages/"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
