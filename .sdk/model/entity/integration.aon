# Entity: integration

main: kit: entity: integration: {

  alias: field: {}

  fields: [
    {
      name: "actions"
      req: false
      short: "Actions this integration exposes."
      type: "`$ARRAY`"
    }
    {
      name: "auth_type"
      req: false
      short: "How Conecto authenticates to base_url."
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "base_url"
      req: true
      short: "Root URL Conecto POSTs actions to."
      type: "`$STRING`"
    }
    {
      name: "credential"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: true
      short: "Human-readable name."
      type: "`$STRING`"
    }
    {
      name: "signing_secret"
      req: false
      short: "Secret used to sign action calls."
      type: "`$STRING`"
    }
    {
      name: "slug"
      req: true
      short: "Stable identifier, used in the path."
      type: "`$STRING`"
    }
    {
      name: "widget_ids"
      req: false
      type: "`$ARRAY`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "integration"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "slug"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/integrations/{slug}/install/"
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "slug"
            }
            {
              lit: "install"
            }
          ]
          select: {
            "$action": "install"
            exist: [
              "slug"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "slug"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/integrations/{slug}/rotate_signing_secret/"
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "slug"
            }
            {
              lit: "rotate_signing_secret"
            }
          ]
          select: {
            "$action": "rotate_signing_secret"
            exist: [
              "slug"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/integrations/"
          segments: [
            {
              lit: "integrations"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/integrations/"
          segments: [
            {
              lit: "integrations"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.integrations`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "slug"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/integrations/{slug}/"
          rename: {
            param: {
              slug: "id"
            }
          }
          segments: [
            {
              lit: "integrations"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "integration"
      ]
    ]
  }



}
