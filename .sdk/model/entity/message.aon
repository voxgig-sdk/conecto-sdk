# Entity: message

main: kit: entity: message: {

  alias: field: {}

  fields: [
    {
      name: "ask_email"
      req: false
      short: "Prompt the visitor for an email address."
      type: "`$BOOLEAN`"
    }
    {
      name: "blocks"
      req: false
      short: "At most 10."
      type: "`$ARRAY`"
    }
    {
      name: "body"
      req: false
      type: "`$STRING`"
    }
    {
      name: "buttons"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "internal"
      req: false
      short: "Internal note, not shown to the visitor."
      type: "`$BOOLEAN`"
    }
    {
      name: "products"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "ticket_form"
      req: false
      short: "Show the ticket form."
      type: "`$BOOLEAN`"
    }
  ]

  name: "message"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            header: [
              {
                kind: "header"
                name: "idempotency_key"
                orig: "idempotency_key"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "session"
                orig: "session"
                reqd: true
                type: "`$STRING`"
              }
              {
                kind: "param"
                name: "widget_id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "POST"
          orig: "/widgets/{id}/visitors/{session}/message/"
          parts: [
            "widgets"
            "{widget_id}"
            "visitors"
            "{session}"
            "message"
          ]
          rename: {
            param: {
              id: "widget_id"
            }
          }
          select: {
            exist: [
              "idempotency_key"
              "session"
              "widget_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "idempotency_key"
                orig: "idempotency_key"
                reqd: false
                type: "`$STRING`"
              }
            ]
            params: [
              {
                kind: "param"
                name: "conversation_id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "POST"
          orig: "/conversations/{id}/messages/"
          parts: [
            "conversations"
            "{conversation_id}"
            "messages"
          ]
          rename: {
            param: {
              id: "conversation_id"
            }
          }
          select: {
            exist: [
              "conversation_id"
              "idempotency_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "conversation"
      ]
      [
        "widget"
        "visitor"
      ]
    ]
  }



}
