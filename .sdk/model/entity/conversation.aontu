# Entity: conversation

main: kit: entity: conversation: {

  alias: field: {}

  fields: [
    {
      name: "body"
      req: false
      short: "Opening message."
      type: "`$STRING`"
    }
    {
      name: "created_at"
      req: false
      type: "`$STRING`"
    }
    {
      name: "id"
      req: true
      short: "Conversation id."
      type: "`$INTEGER`"
    }
    {
      name: "messages"
      req: false
      short: "Visitor-facing messages, oldest first."
      type: "`$ARRAY`"
    }
    {
      name: "session"
      req: false
      short: "Visitor browser session key."
      type: "`$STRING`"
    }
    {
      name: "status"
      req: true
      short: "Lifecycle state."
      type: "`$STRING`"
    }
    {
      name: "user_id"
      req: true
      type: "`$INTEGER`"
    }
    {
      name: "widget_id"
      req: false
      short: "Widget the conversation belongs to."
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "conversation"
  op: {
    create: {
      name: "create"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "POST"
          orig: "/conversations/{id}/assign/"
          parts: [
            "conversations"
            "{id}"
            "assign"
          ]
          select: {
            "$action": "assign"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "POST"
          orig: "/conversations/{id}/handoff/"
          parts: [
            "conversations"
            "{id}"
            "handoff"
          ]
          select: {
            "$action": "handoff"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            header: [
              {
                kind: "header"
                name: "idempotency_key"
                orig: "idempotency_key"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "POST"
          orig: "/conversations/"
          parts: [
            "conversations"
          ]
          select: {
            exist: [
              "idempotency_key"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "before_id"
                orig: "before_id"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 25
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "session"
                orig: "session"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "status"
                orig: "status"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "widget_id"
                orig: "widget_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/conversations/"
          parts: [
            "conversations"
          ]
          select: {
            exist: [
              "before_id"
              "limit"
              "session"
              "status"
              "widget_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.conversations`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
            query: [
              {
                kind: "query"
                name: "since_id"
                orig: "since_id"
                reqd: false
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/conversations/{id}/"
          parts: [
            "conversations"
            "{id}"
          ]
          select: {
            exist: [
              "id"
              "since_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "PATCH"
          orig: "/conversations/{id}/messages/"
          parts: [
            "conversations"
            "{id}"
            "messages"
          ]
          select: {
            "$action": "message"
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
